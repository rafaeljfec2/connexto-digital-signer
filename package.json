{
  "name": "connexto-digital-signer",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "docker:build": "cd docker && docker compose build",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev:api": "pnpm --filter api dev",
    "build:api": "pnpm --filter api build",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "prepare": "husky",
    "hooks:pre-commit": "node scripts/git-hooks/pre-commit.cjs",
    "hooks:pre-push": "node scripts/git-hooks/pre-push.cjs",
    "version:bump-apps": "node scripts/git-hooks/bump-app-versions.cjs",
    "postinstall": "node scripts/apply-security-patches.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.10.0",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.2.0",
    "turbo": "^2.11.10",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=24.22.1"
  }
}
