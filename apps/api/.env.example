NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=connexto_signer
DB_LOGGING=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Nest @Cron (reminders + expired envelopes). Set to false on API pods that must
# not run the scheduler (e.g. when a dedicated replica owns cron).
# ENABLE_SCHEDULER=true
ENABLE_SCHEDULER=true

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=documents
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

JWT_SECRET=change-in-production
JWT_EXPIRES_IN=60m
CERTIFICATE_ENCRYPTION_KEY=

APP_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:3001

# Email delivery (MailerSend). Without MAILERSEND_API_KEY in development, driver=logger.
# EMAIL_DRIVER=mailersend|logger|inmemory
# Production requires EMAIL_DRIVER=mailersend (default) and MAILERSEND_API_KEY.
MAILERSEND_API_KEY=
MAILERSEND_FROM_EMAIL=noreply@connexto.com.br
MAILERSEND_FROM_NAME=NexoSign

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
THROTTLE_PUBLIC_TTL_SECONDS=60
THROTTLE_PUBLIC_LIMIT=10

AI_API_KEY=your-api-key
